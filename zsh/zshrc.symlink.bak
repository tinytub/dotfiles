fi

# Attach existing tmux session or create new one
# https://qiita.com/ssh0/items/a9956a74bff8254a606a
TMUX_CONF_DIR=$HOME
tmux-launch () {
    autoload -Uz is-at-least
    if (( $+commands[tmux] * !$+TMUX )) && is-at-least 5.2.0 && (( ! $+DISABLE_AUTO_TMUX_ATTACH )); then
       () {
          # Build session lists
          # Colons(:) are used as delimiter
          local -a sess_names
          local sess_list="$(command tmux list-session 2> /dev/null)"
          if [[ -n $sess_list ]]; then
             sess_names+=("${(@f)sess_list}")
          fi
          local new_sess_id="c"
          sess_names+=("$new_sess_id: Create new session")
          local sess_ids=("${(@f)"$(echo ${(F)sess_names} | cut -d: -f1)"}")
    
          local sess_id
          if (( $+commands[fzf] )); then
             sess_id="$(echo ${(F)sess_names[@]} | fzf | cut -d: -f1)"
          else
             print -u 2 -l "[TMUX Manager]" \
                "Do you want to attach or create tmux session?"
             print -u 2 -l -x 4 -- "\t"$^sess_names
             read sess_id\?"Please enter ID (${(j:/:)sess_ids}): "
          fi
    
          if [[ "$sess_id" == "$new_sess_id" ]]; then
             tmux -f "$TMUX_CONF_DIR/.tmux.conf" new-session
          elif (( $+sess_ids[(re)$sess_id] )); then
             tmux attach-session -d -t "$sess_id"
          else
             print -u 2 -- "Unknown ID: $sess_id. Abort."
             :  # Start terminal normally
          fi
       }
    fi
}

checkrabbish() {
# Kill unknown high cpu usage process
# Run the ps command and store the output in a variable
ps_output=$(ps -ef | grep diagnosticd | grep -v "grep")
# Check if the output contains the diagnosticd process
if [ -n "$ps_output" ]; then
    # Extract the PID of the diagnosticd process
    pid=$(echo "$ps_output" | awk '{print $2}')
    sudo kill -9 $pid
    # Kill the diagnosticd process using the PID
    #echo "diagnosticd process with PID $pid has been founded. use \"sudo kill -9 $pid\""
    echo "\"diagnosticd\" process with PID $pid has been killed."
fi

kill_target_processes() {
  local targets=("JDITDesk" "HiOffice" "HioUpdate" "HioNetwork" "HioNetFilter" "JDITTray")
  for pname in "${targets[@]}"; do
    # 查找进程ID
    pids=$(pgrep -x "$pname")
    #pids=$(pgrep -f "$pname")

    if [[ -n "$pids" ]]; then
      echo "发现进程 $pname，PID: $pids，正在终止..."
      sudo kill -9 $pids
      echo "$pname 已被终止。"
    else
     # echo "未发现进程 $pname。"
    fi
  done
}
start_socat_8988() {
  # 检查是否已有 socat 监听 127.0.0.1:8988
  if lsof -nP -iTCP:8988 -sTCP:LISTEN | grep -q 'socat'; then
  else
    echo "未检测到 socat 监听 127.0.0.1:8988，正在后台启动..."
    nohup socat TCP4-LISTEN:8988,bind=127.0.0.1,fork - >/dev/null 2>&1 &
  fi
}

