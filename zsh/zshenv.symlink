

#export TERM="xterm-256color"
# LANG 如设置为 en_US 会导致特殊字符乱码
#export LANG=zh_CN.UTF-8

export LC_ALL=en_US.UTF-8  
export LANG=en_US.UTF-8
setopt COMBINING_CHARS

# PATH helper，让目录管理集中且去重。
path_prepend() {
  local dir
  for dir in "$@"; do
    [[ -z "$dir" ]] && continue
    path=("$dir" ${(@)path:#$dir})
  done
}

path_append() {
  local dir
  for dir in "$@"; do
    [[ -z "$dir" ]] && continue
    path=(${(@)path:#$dir} "$dir")
  done
}

path_prepend /opt/homebrew/opt/mysql-client/bin

# 固定你的 GOPATH（用回你习惯的路径）
export GOPATH="/Users/zhaopeng18/Documents/local_projects/goworks"

# 私有仓库配置（保持不变，对 JD 内部开发至关重要）
export GO111MODULE="on"
export GOPRIVATE="git.jd.com,coding.jd.com"
export GONOSUMDB="coding.jd.com"
export GOPROXY="https://goproxy.cn,direct" # 建议加个国内镜像，挂了再走 direct

# 再把 GOPATH/bin 放进去，确保 go install 的工具（如 golangci-lint, delve）能直接搜到
path_prepend "$GOPATH/bin"

# 注意：不要手动设置 GOROOT，asdf 会通过 shim 自动处理。


export KUBE_EDITOR="/usr/bin/vim"
path_append /usr/local/kubebuilder/bin

path_prepend "$HOME/bin"
path_prepend /usr/local/opt/ruby/bin
