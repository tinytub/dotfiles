

#export TERM="xterm-256color"
# LANG 如设置为 en_US 会导致特殊字符乱码
#export LANG=zh_CN.UTF-8

export LC_ALL=en_US.UTF-8  
export LANG=en_US.UTF-8
setopt COMBINING_CHARS

# PATH helper，让目录管理集中且去重。
path_prepend() {
  local dir
  for dir in "$@"; do
    [[ -z "$dir" ]] && continue
    path=("$dir" ${(@)path:#$dir})
  done
}

path_append() {
  local dir
  for dir in "$@"; do
    [[ -z "$dir" ]] && continue
    path=(${(@)path:#$dir} "$dir")
  done
}

path_prepend /opt/homebrew/opt/mysql-client/bin

path_prepend "${ASDF_DATA_DIR:-$HOME/.asdf}/shims"
#export PATH="/Users/zhaopeng18/.asdf/installs/golang/1.24.3/bin:$PATH"
#export PATH="/Users/zhaopeng18/.asdf/installs/golang/1.24.3/go/bin:$PATH"

. ${ASDF_DATA_DIR:-$HOME/.asdf}/plugins/golang/set-env.zsh
asdf_update_golang_env

_asdf_golang_path_update() {
  if [[ -n "$GOBIN" ]]; then
    path=($GOBIN ${(@)path:#$GOBIN})
  fi
}

add-zsh-hook precmd _asdf_golang_path_update
_asdf_golang_path_update


