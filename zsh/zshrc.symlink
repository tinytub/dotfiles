# 基础：oh-my-zsh + zinit + fzf + starship

# Disable OMZ auto title to save precmd time (~45ms)
export DISABLE_AUTO_TITLE="true"
# Disable OMZ magic functions (url-quote-magic, bracketed-paste-magic) to fix paste lag
export DISABLE_MAGIC_FUNCTIONS="true"

export ZSH=$HOME/.oh-my-zsh
source $ZSH/oh-my-zsh.sh

# fzf 默认行为
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh
export FZF_DEFAULT_COMMAND='rg --files --hidden --glob "!.git"'
export FZF_DEFAULT_OPTS='--height 40% --reverse --border --color=bg+:23 -m'
export FZF_CTRL_T_OPTS="--preview '(highlight -O ansi -l {} 2> /dev/null || cat {} || tree -C {}) 2> /dev/null | head -200'"

# 缺失时自动安装 zinit
if [[ ! -f $HOME/.local/share/zinit/zinit.git/zinit.zsh ]]; then
    print -P "%F{33} %F{220}Installing %F{33}ZDHARMA-CONTINUUM%F{220} Initiative Plugin Manager (%F{33}zdharma-continuum/zinit%F{220})…%f"
    command mkdir -p "$HOME/.local/share/zinit" && command chmod g-rwX "$HOME/.local/share/zinit"
    command git clone https://github.com/zdharma-continuum/zinit "$HOME/.local/share/zinit/zinit.git" && \
        print -P "%F{33} %F{34}Installation successful.%f%b" || \
        print -P "%F{160} The clone has failed.%f%b"
fi

source "$HOME/.local/share/zinit/zinit.git/zinit.zsh"
autoload -Uz _zinit
(( ${+_comps} )) && _comps[zinit]=_zinit

ZINIT[COMPINIT_OPTS]='-u'   # 忽略 compinit 安全提示

zinit light-mode for \
    zdharma-continuum/zinit-annex-as-monitor \
    zdharma-continuum/zinit-annex-bin-gem-node \
    zdharma-continuum/zinit-annex-patch-dl \
    zdharma-continuum/zinit-annex-rust

# Zinit plugins

zinit ice wait'0a' lucid id-as"junegunn/fzf_completions" pick"/dev/null" multisrc"shell/{completion,key-bindings}.zsh"
zinit light junegunn/fzf

# Starship via zinit：只负责下载二进制到 PATH
zinit ice as"command" from"gh-r"
zinit light starship/starship

# fzf-git.sh: 通过 fzf 浏览 git 对象
zinit ice wait'2a' lucid depth'1'
zinit snippet 'https://raw.githubusercontent.com/junegunn/fzf-git.sh/main/fzf-git.sh'

# fzf-tab：增强所有补全为 fzf 交互
zinit ice wait'2a' lucid
zinit light Aloxaf/fzf-tab

zinit wait lucid for \
  OMZP::colored-man-pages \
  OMZP::brew \
  OMZP::golang \
  OMZP::kubectl \
  OMZP::ssh-agent \
  OMZP::command-not-found \
  OMZP::docker-compose

zinit light zsh-users/zsh-completions

# 语法高亮与历史搜索
zinit ice wait'0a' lucid \
    atload"zicompinit; zpcdreplay; FAST_HIGHLIGHT[chroma-man]="
zinit light zdharma-continuum/fast-syntax-highlighting
zinit ice wait'1b' lucid
zinit light zsh-users/zsh-history-substring-search
zinit ice wait'1c' lucid trackbinds bindmap'^R -> ^S'
zinit light zdharma-continuum/history-search-multi-word

# autosuggestions（需在高亮之后）
zinit ice wait'0b' lucid atload'_zsh_autosuggest_start' compile'{src/*.zsh,src/strategies/*}'
zinit light zsh-users/zsh-autosuggestions

# LS_COLORS 定制（macOS 需 gsed/gdircolors）
zinit ice pick"c.zsh" atclone"local PFX=${${(M)OSTYPE:#*darwin*}:+g}
            git reset --hard;
            \${PFX}sed -i '/DIR/c\DIR                   38;5;105;1' LS_COLORS; \
            \${PFX}sed -i '/LINK/c\LINK                 38;5;115' LS_COLORS; \
            \${PFX}dircolors -b LS_COLORS > c.zsh" atpull'%atclone' nocompile'!'
zinit light trapd00r/LS_COLORS

# rupa/z（老牌 z：提供 z 命令 & 数据库逻辑，很多补全/插件围绕它）
zinit ice wait'0d' lucid blockf
zinit light rupa/z

# changyuheng/fz（关键：让 z+[Tab] / zz+[Tab] 列出候选）
zinit ice wait'0e' lucid
zinit light changyuheng/fz

# 可选：andrewferrier/fzf-z（提供 ctrl-g 等快捷跳转）
zinit ice wait'0f' lucid
zinit light andrewferrier/fzf-z

# Zoxide: smarter z replacement（需 Homebrew 安装）
# eval "$(zoxide init zsh)"

# 常用按键
bindkey "^[[1;5C" forward-word                      # [Ctrl-right] - forward one word
bindkey "^[[1;5D" backward-word                     # [Ctrl-left] - backward one word
bindkey '^[^[[C' forward-word                       # [Ctrl-right] - forward one word
bindkey '^[^[[D' backward-word                      # [Ctrl-left] - backward one word
bindkey '^[[1;3D' beginning-of-line                 # [Alt-left] - beginning of line
bindkey '^[[1;3C' end-of-line                       # [Alt-right] - end of line
bindkey '^[[5D' beginning-of-line                   # [Alt-left] - beginning of line
bindkey '^[[5C' end-of-line                         # [Alt-right] - end of line
bindkey '^?' backward-delete-char                   # [Backspace] - delete backward
if [[ "${terminfo[kdch1]}" != "" ]]; then
    bindkey "${terminfo[kdch1]}" delete-char        # [Delete] - delete forward
else
    bindkey "^[[3~" delete-char                     # [Delete] - delete forward
    bindkey "^[3;5~" delete-char
    bindkey "\e[3~" delete-char
fi
bindkey "^A" vi-beginning-of-line
bindkey -M viins "^F" vi-forward-word               # [Ctrl-f] - move to next word
bindkey -M viins "^E" vi-add-eol                    # [Ctrl-e] - move to end of line
bindkey "^J" history-beginning-search-forward
bindkey "^K" history-beginning-search-backward

# 补全设置
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'
zstyle ':completion:*' insert-tab pending
zstyle ':completion:*' completer _expand _complete _files _correct _approximate

# == fzf-tab
zstyle ':fzf-tab:complete:z:*' query-string input
zstyle ':fzf-tab:complete:kill:argument-rest' fzf-preview 'ps --pid=$word -o cmd --no-headers -w -w'
zstyle ':fzf-tab:complete:kill:argument-rest' fzf-flags '--preview-window=down:3:wrap'
zstyle ':fzf-tab:complete:kill:*' popup-pad 0 3
# zstyle ':fzf-tab:complete:cd:*' fzf-preview 'exa -1 --color=always $realpath'
zstyle ':fzf-tab:complete:cd:*' fzf-preview '
  if command -v eza >/dev/null; then eza -1 --color=always "$realpath";
  elif command -v exa >/dev/null; then exa -1 --color=always "$realpath";
  else ls -1 "$realpath";
  fi'
zstyle ':fzf-tab:complete:cd:*' popup-pad 30 0
zstyle ":fzf-tab:*" fzf-flags --color=bg+:23
if [[ -n "$TMUX" ]]; then
  zstyle ':fzf-tab:*' fzf-command ftb-tmux-popup
else
  zstyle ':fzf-tab:*' fzf-command fzf
fi
zstyle ':fzf-tab:*' switch-group ',' '.'
zstyle ':fzf-tab:complete:git-checkout:*' fzf-preview 'git log -n 20 --oneline --decorate $word 2>/dev/null'
zstyle ':fzf-tab:complete:kubectl:*' fzf-preview 'kubectl get -o wide ${words[2]} $word 2>/dev/null | head -50'
zstyle ":completion:*:git-checkout:*" sort false
#zstyle ':completion:*' file-sort modification
zstyle ':completion:*' file-sort name
zstyle ':completion:*:exa' sort false
zstyle ':completion:files' sort false

alias vi="nvim"
alias vim="nvim"
alias vimdiff='nvim -d'
alias glg="git log --graph --all --oneline"

# fzf-git.sh 快捷函数
gcof() {                       # checkout 分支/tag/commit（综合）
  local ref
  ref=$(_fzf_git_each_ref --no-multi) || return
  git checkout "$ref"
}

gbrd() {                       # 选择分支并删除
  local branch
  branch=$(_fzf_git_branches --no-multi) || return
  git branch -d "$branch"
}

gstf() {                       # 用 fzf 选文件再 git status / diff
  local files
  files=$(_fzf_git_files) || return
  echo "$files" | xargs git status --short
}

alias sed="gsed"
alias reload="source ~/.zshrc"
if ls --color > /dev/null 2>&1; then # GNU `ls`
    colorflag="--color"
else # macOS `ls`
    colorflag="-G"
fi
alias l="ls -lah ${colorflag}"
alias ls="ls -ah ${colorflag}"
alias la="ls -AF ${colorflag}"
alias ll="ls -lFh ${colorflag}"
alias lld="ls -l | grep ^d"
alias rmf="rm -rf"

# tmux aliases
alias ta='tmux attach'
alias tls='tmux ls'
alias tat='tmux attach -t'
alias tns='tmux new-session'

# 删除 zinit 添加的有冲突的 alias
unalias zi 2>/dev/null
unalias zz 2>/dev/null
unalias zini 2>/dev/null
unalias zpl 2>/dev/null
unalias zplg 2>/dev/null
alias zz='z -i'

alias typora="open -a typora"

alias ssh='TERM="xterm-256color" ssh'

# bat 替代 cat
if type "bat" >/dev/null 2>&1; then
    alias cat="bat"
    export BAT_PAGER="less -RFX"
fi

TMUX_CONF_DIR=$HOME
# tmux-launch：fzf 选择已有 session，或新建一个
tmux-launch () {
    autoload -Uz is-at-least
    if (( $+commands[tmux] * !$+TMUX )) && is-at-least 5.2.0 && (( ! $+DISABLE_AUTO_TMUX_ATTACH )); then
       () {
          local -a sess_names
          local sess_list="$(command tmux list-session 2> /dev/null)"
          if [[ -n $sess_list ]]; then
             sess_names+=("${(@f)sess_list}")
          fi
          local new_sess_id="c"
          sess_names+=("$new_sess_id: Create new session")
          local sess_ids=("${(@f)"$(echo ${(F)sess_names} | cut -d: -f1)"}")

          local sess_id
          if (( $+commands[fzf] )); then
             sess_id="$(echo ${(F)sess_names[@]} | fzf | cut -d: -f1)"
          else
             print -u 2 -l "[TMUX Manager]" \
                "Do you want to attach or create tmux session?"
             print -u 2 -l -x 4 -- "\t"$^sess_names
             read sess_id\?"Please enter ID (${(j:/:)sess_ids}): "
          fi

          if [[ "$sess_id" == "$new_sess_id" ]]; then
             tmux -f "$TMUX_CONF_DIR/.tmux.conf" new-session
          elif (( $+sess_ids[(re)$sess_id] )); then
             tmux attach-session -d -t "$sess_id"
          else
             print -u 2 -- "Unknown ID: $sess_id. Abort."
             :  # Start terminal normally
          fi
       }
    fi
}

start_socat_8988() {
  if ! lsof -nP -iTCP:8988 -sTCP:LISTEN | grep -q 'socat'; then
    echo "未检测到 socat 监听 127.0.0.1:8988，正在后台启动..."
    nohup socat TCP4-LISTEN:8988,bind=127.0.0.1,fork - >/dev/null 2>&1 &
  fi
}

checkrabbish() {
  local all_pids=()
  local found_names=()
  
  # 1. 检查 diagnosticd
  local diag_pid=$(ps -ef | grep "[d]iagnosticd" | awk '{print $2}')
  if [[ -n "$diag_pid" ]]; then
    all_pids+=($diag_pid)
    found_names+=("diagnosticd")
  fi

  # 2. 检查其他目标进程
  local targets=("JDITDesk" "HiOffice" "HioUpdate" "HioNetwork" "HioNetFilter" "JDITTray")
  for pname in "${targets[@]}"; do
    local pids=$(pgrep -x "$pname")
    if [[ -n "$pids" ]]; then
      all_pids+=(${(f)pids})
      found_names+=("$pname")
    fi
  done

  # 3. 如果发现进程，提示手动执行命令
  if [[ ${#all_pids[@]} -gt 0 ]]; then
    local unique_names=(${(u)found_names})
    echo "⚠️  检测到垃圾进程: ${(j:, :)unique_names}"
    echo "手动清理请执行: sudo kill -9 ${all_pids[*]}"
  fi

  start_socat_8988
}

eval "$(starship init zsh)"
# Mise: use shims mode for better performance (avoids precmd hook lag)
# eval "$(mise activate zsh)"
export PATH="$HOME/.local/share/mise/shims:$PATH"

# kitty prompt
if [[ -n $KITTY_INSTALLATION_DIR ]]; then
  ZSH_THEME_TERM_TITLE_IDLE="%1d"
  function precmd () {
    window_title="\033]0;${PWD##*/}\007"
    echo -ne "$window_title"
  }
fi

test -e "${HOME}/.iterm2_shell_integration.zsh" && source "${HOME}/.iterm2_shell_integration.zsh"

# 后台执行清理任务
#checkrabbish &!
checkrabbish

alias gf=gf

