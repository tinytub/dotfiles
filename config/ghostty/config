shell-integration-features = no-cursor
scrollback-limit = 100000
custom-shader-animation = true
copy-on-select = clipboard
theme = tokyonight storm
background = #24283b
foreground = #c0caf5
selection-background = #364a82
selection-foreground = #c0caf5
cursor-color = #c0caf5
cursor-style-blink = false
palette = 0=#1d202f
palette = 1=#f7768e
palette = 2=#9ece6a
palette = 3=#e0af68
palette = 4=#7aa2f7
palette = 5=#bb9af7
palette = 6=#7dcfff
palette = 7=#a9b1d6
palette = 8=#414868
palette = 9=#f7768e
palette = 10=#9ece6a
palette = 11=#e0af68
palette = 12=#7aa2f7
palette = 13=#bb9af7
palette = 14=#7dcfff
palette = 15=#c0caf5
font-thicken = false

font-family = "TX-02"
font-size = 14
font-feature = zero
# font-feature = calt
# font-feature = liga
font-codepoint-map = U+e0b0-U+e0b3,U+e0b4-U+e0c8,U+e0cc-U+e0d4,U+e0ca=JetBrainsMono Nerd Font Mono
font-codepoint-map = U+f000-U+f2e0,U+e200-U+e2a9=JetBrainsMono Nerd Font Mono
font-codepoint-map = U+e5fa-U+e6b1=JetBrainsMono Nerd Font Mono
font-codepoint-map = U+ea60-U+ebeb=JetBrainsMono Nerd Font Mono

#font-family = "Berkeley Mono Variable"
font-family = JetBrainsMonoNL Nerd Font Mono
font-family = Anonymice Nerd Font ## -- v2.3.3, 适配老图标
font-family = Hack Nerd Font Mono
font-family = NotoMono Nerd Font Mono
font-family = Symbols Nerd Font Mono
#font-family = Heiti SC
font-family = PingFang SC
#font-feature = -calt, -dlig, -liga
#font-feature = -calt, -liga
font-feature = -calt

adjust-cursor-thickness = 300%
mouse-hide-while-typing = true
macos-option-as-alt = true
auto-update = check
auto-update-channel = tip